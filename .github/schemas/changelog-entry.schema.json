{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ton77v/changelog-forms-demo/schemas/changelog-entry.schema.json",
  "title": "Changelog version",
  "type": "object",
  "required": ["version", "release_date", "entries"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-(rc|beta|alpha)\\d*)?$",
      "description": "Semver; pre-release suffixes -rcN/-betaN/-alphaN allowed"
    },
    "release_date": {
      "type": "string",
      "format": "date"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "components", "text"],
        "additionalProperties": false,
        "properties": {
          "type": {
            "enum": ["new", "fix", "security", "warning", "enhancement"]
          },
          "components": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["es", "kbn"] }
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
